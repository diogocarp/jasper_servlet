<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                                  http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="UserReport"
              pageWidth="595" pageHeight="842" columnWidth="515"
              leftMargin="40" rightMargin="40" topMargin="50" bottomMargin="50">

    <style name="HeaderStyle" mode="Opaque" backcolor="#1976D2" forecolor="white" fontSize="12" isBold="true" />
    <style name="CellStyle" mode="Transparent" fontSize="10" />

    <parameter name="ReportTitle"/>

    <!-- Campos -->
    <field name="id" class="java.lang.Long"/>
    <field name="name"/>
    <field name="email"/>
    <field name="role"/>
    <field name="active" class="java.lang.Boolean"/>
    <field name="createdAt" class="java.time.LocalDateTime"/>
    <field name="updatedAt" class="java.time.LocalDateTime"/>

    <title>
        <band height="50">
            <staticText>
                <reportElement x="0" y="0" width="515" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="18" isBold="true"/>
                </textElement>
                <text>Relatório de Usuários</text>
            </staticText>
            <line>
                <reportElement x="0" y="35" width="515" height="1" forecolor="#1976D2"/>
            </line>
        </band>
    </title>

    <columnHeader>
        <band height="25">
            <staticText>
                <reportElement x="0" y="0" width="40" height="25" style="HeaderStyle"/>
                <text>ID</text>
            </staticText>
            <staticText>
                <reportElement x="40" y="0" width="120" height="25" style="HeaderStyle"/>
                <text>Nome</text>
            </staticText>
            <staticText>
                <reportElement x="160" y="0" width="160" height="25" style="HeaderStyle"/>
                <text>E-mail</text>
            </staticText>
            <staticText>
                <reportElement x="320" y="0" width="60" height="25" style="HeaderStyle"/>
                <text>Cargo</text>
            </staticText>
            <staticText>
                <reportElement x="380" y="0" width="40" height="25" style="HeaderStyle"/>
                <text>Status</text>
            </staticText>
            <staticText>
                <reportElement x="420" y="0" width="95" height="25" style="HeaderStyle"/>
                <text>Data de Criação</text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Detalhe -->
    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="40" height="20" style="CellStyle"/>
                <textFieldExpression><![CDATA[$F{id}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="40" y="0" width="120" height="20" style="CellStyle"/>
                <textFieldExpression><![CDATA[$F{name}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="160" y="0" width="160" height="20" style="CellStyle"/>
                <textFieldExpression><![CDATA[$F{email}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="320" y="0" width="60" height="20" style="CellStyle"/>
                <textFieldExpression><![CDATA[$F{role}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="380" y="0" width="40" height="20" style="CellStyle"/>
                <textFieldExpression><![CDATA[$F{active} ? "Ativo" : "Inativo"]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="420" y="0" width="95" height="20" style="CellStyle"/>
                <textFieldExpression><![CDATA[$F{createdAt}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Rodapé -->
    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="400" y="0" width="115" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

</jasperReport>
